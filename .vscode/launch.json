{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: UI",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app/report_ui.py"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Build index: smoke (--limit 40)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/build_index.py",
      "args": ["--limit", "40"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Build index: full",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/build_index.py",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Init DuckDB",
      "type": "debugpy",
      "request": "launch",
      "module": "app.db",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
