# Copy this file to ".env" and adjust as needed.

# Ollama local API (default install listens here)
OLLAMA_HOST=http://localhost:11434

# Models — pull these with `ollama pull <name>` first.
# See README for how to confirm current catalog names.
CHAT_MODEL=llama3.1:8b-instruct-q4_K_M
EMBED_MODEL=nomic-embed-text

# Identify yourself politely to the wiki (required for responsible scraping).
# Put a real contact address here so the wiki admins can reach you.
WIKI_USER_AGENT=poebuddy/0.1 (personal research tool; contact: you@example.com)

# MediaWiki API base for the PoE2 wiki. VERIFY this is current before bulk fetching.
WIKI_API_URL=https://www.poe2wiki.net/w/api.php
